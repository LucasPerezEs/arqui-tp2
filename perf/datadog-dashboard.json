        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "requests",
                "query": "sum:arvault.arca.requests{service:arvault,$env,$host}.as_rate().rollup(sum,10)"
              },
              {
                "data_source": "metrics",
                "name": "approved",
                "query": "sum:arvault.arca.approved{service:arvault,$env,$host}.as_rate().rollup(sum,10)"
