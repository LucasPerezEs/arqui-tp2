              {
                "data_source": "metrics",
                "name": "average",
                "query": "avg:arvault.arca.duration_ms.avg{service:arvault,$env,$host} by {host,outcome}"
              },
              {
                "data_source": "metrics",
                "name": "p95",
                "query": "avg:arvault.arca.duration_ms.95percentile{service:arvault,$env,$host} by {host,outcome}"
              }
            ],
            "formulas": [
              {
                "formula": "average",
                "alias": "Media por nodo e intervalo"
              },
              {
                "formula": "p95",
                "alias": "p95 por nodo e intervalo"
              }
            ],
            "response_format": "timeseries",
