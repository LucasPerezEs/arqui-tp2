            "queries": [
              {
                "data_source": "metrics",
                "name": "completed",
                "query": "sum:artillery.vusers.completed{$test,$case,$run}.as_rate().rollup(sum,10)"
              },
              {
                "data_source": "metrics",
                "name": "failed",
                "query": "sum:artillery.vusers.failed{$test,$case,$run}.as_rate().rollup(sum,10)"
              }
