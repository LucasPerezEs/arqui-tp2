                "data_source": "metrics",
                "name": "rejected",
                "query": "sum:arvault.arca.rejected{service:arvault,$env,$host}.as_rate().rollup(sum,10)"
              },
              {
                "data_source": "metrics",
                "name": "errors",
                "query": "sum:arvault.arca.errors{service:arvault,$env,$host}.as_rate().rollup(sum,10)"
              }
            ],
            "formulas": [
              {
                "formula": "requests",
                "alias": "Consultas/s"
              },
              {
                "formula": "approved",
                "alias": "Aprobadas/s"
              },
              {
                "formula": "rejected",
                "alias": "Rechazadas/s"
              },
              {
                "formula": "errors",
                "alias": "Errores/s"
              }
            ],
            "response_format": "timeseries",
            "display_type": "line"
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": true,
          "min": "0"
        }
      },
      "layout": {
        "x": 0,
        "y": 14,
        "width": 6,
        "height": 3
      }
    },
    {
