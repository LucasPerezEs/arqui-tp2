            "formulas": [
              {
                "formula": "completed",
                "alias": "VU completados/s"
              },
              {
                "formula": "failed",
                "alias": "VU fallidos/s"
              }
            ],
            "response_format": "timeseries",
            "display_type": "line"
          }
        ],
        "yaxis": {
          "min": "0",
          "scale": "linear",
          "include_zero": true
        }
      },
      "layout": {
        "x": 6,
        "y": 8,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 8,
      "definition": {
        "type": "timeseries",
        "title": "CPU por nodo: 100 - idle (%)",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "idle",
                "query": "avg:system.cpu.idle{host:tp2vmss*,$host} by {host}"
              }
            ],
            "formulas": [
              {
                "formula": "100 - idle",
                "alias": "CPU no ociosa"
              }
            ],
            "response_format": "timeseries",
            "display_type": "line"
          }
        ],
        "yaxis": {
          "min": "0",
          "max": "100",
          "scale": "linear",
          "include_zero": true
        }
      },
      "layout": {
        "x": 0,
        "y": 11,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 9,
      "definition": {
        "type": "timeseries",
        "title": "Memoria no disponible por nodo (%)",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "total",
                "query": "avg:system.mem.total{host:tp2vmss*,$host} by {host}"
              },
              {
                "data_source": "metrics",
                "name": "usable",
                "query": "avg:system.mem.usable{host:tp2vmss*,$host} by {host}"
              }
            ],
            "formulas": [
              {
                "formula": "100 * (total - usable) / total",
                "alias": "100 × (total - usable) / total"
              }
            ],
            "response_format": "timeseries",
            "display_type": "line"
          }
        ],
        "yaxis": {
          "min": "0",
          "max": "100",
          "scale": "linear",
          "include_zero": true
        }
      },
      "layout": {
        "x": 6,
        "y": 11,
        "width": 6,
        "height": 3
      }
    },
    {
      "id": 10,
      "definition": {
        "type": "timeseries",
